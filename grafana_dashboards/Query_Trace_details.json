          "format": "traces",
          "query": "SELECT\n  lower(hex(trace_id)) as traceID,\n  lower(hex(span_id)) as spanID,\n  if(parent_span_id = 0, '', lower(hex(parent_span_id))) as parentSpanID,\n  hostname as serviceName,\n  operation_name as operationName,\n  intDiv(start_time_us, 1000) as startTime,\n  intDiv(finish_time_us - start_time_us, 1000) as duration,\n  attribute as tags,\n  map('server.address', hostname) as serviceTags\nFROM default.distributed_opentelemetry_span_log\nWHERE trace_id GLOBAL IN (\n  SELECT DISTINCT trace_id\n  FROM default.distributed_opentelemetry_span_log\n  WHERE attribute['clickhouse.query_id'] = '$queryId'\n)\nORDER BY start_time_us\nLIMIT 1000",
          "rawSql": "SELECT\n  lower(hex(trace_id)) as traceID,\n  lower(hex(span_id)) as spanID,\n  if(parent_span_id = 0, '', lower(hex(parent_span_id))) as parentSpanID,\n  hostname as serviceName,\n  operation_name as operationName,\n  intDiv(start_time_us, 1000) as startTime,\n  intDiv(finish_time_us - start_time_us, 1000) as duration,\n  attribute as tags,\n  map('server.address', hostname) as serviceTags\nFROM default.distributed_opentelemetry_span_log\nWHERE trace_id GLOBAL IN (\n  SELECT DISTINCT trace_id\n  FROM default.distributed_opentelemetry_span_log\n  WHERE attribute['clickhouse.query_id'] = '$queryId'\n)\nORDER BY start_time_us\nLIMIT 1000",
